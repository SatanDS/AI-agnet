DATABASE_URL="file:../data/app.db"
AUTH_SECRET="change-this-to-a-random-string-with-at-least-32-characters"
# Optional. Set to "false" only when testing Docker over plain HTTP.
AUTH_COOKIE_SECURE=""
# Initial owner account. It can manage all users, model settings, presets, and logs.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# openai | local_openai
MODEL_PROVIDER="openai"

# OpenAI cloud provider
# These values are used as initial/fallback settings. Admin Console can override them.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# Local OpenAI-compatible provider, for example http://192.168.1.50:8000/v1
LOCAL_OPENAI_BASE_URL=""
LOCAL_OPENAI_API_KEY=""
LOCAL_OPENAI_MODEL="local-model"
